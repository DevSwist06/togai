{
  "name": "togai-drift-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node src/server/start.js",
    "dev": "npm start",
    "lint": "eslint . --max-warnings=0 && stylelint \"public/**/*.css\" --max-warnings=0 && html-validate \"public/**/*.html\" && prettier . --check",
    "format": "prettier . --write",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node scripts/browser-tests.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:security": "node --test tests/security/*.test.mjs",
    "security:audit": "npm audit --audit-level=low",
    "security": "npm run test:security && npm run security:audit",
    "verify": "npm run lint && npm test && npm run security",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "npm run hooks:install"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@typescript-eslint/parser": "8.70.1",
    "assemblyscript": "0.28.20",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  },
  "description": "Performance-focused WebGPU and WebAssembly downhill racing proof of concept",
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
